---
import Layout from '../../layouts/Layout.astro';
import BrandHeader from '../../components/BrandHeader.astro';
import Footer from '../../components/Footer.astro';
import { blogPosts } from '../../data/blogPosts';

export function getStaticPaths() {
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
---

<Layout title={`${post.title} | RO Service Blog`} description={post.excerpt}>
  <BrandHeader brandName="Expert" brandColor="#0b5ed7" />

  <article class="article-section">
    <div class="container">
      
      <!-- Article Header -->
      <div class="article-header">
        <div class="article-meta">
          <span class="article-date">{post.date}</span>
          <span class="dot">•</span>
          <span class="article-author">By {post.author}</span>
        </div>
        <h1>{post.title}</h1>
      </div>
      
      <!-- Blog Content (HTML rendered) -->
      <div class="article-content" set:html={post.content} />
      
      <!-- Call to Action Box -->
      <div class="article-cta">
        <h3>Need RO Repair or Service in Bangalore?</h3>
        <p>Call our experts for instant doorstep service with a 90-Day Warranty.</p>
        <a href="tel:+919008315606" class="cta-btn">📞 Call Now: +91 9008315606</a>
      </div>

      <!-- Back to Blog Link -->
      <div class="back-link-wrap">
        <a href="/blog" class="back-link">← Back to All Articles</a>
      </div>

    </div>
  </article>

  <Footer brandName="RO" brandColor="#0b5ed7" />
</Layout>

<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  .container { max-width: 800px; margin: 0 auto; padding: 0 20px; }
  h1, h2, h3, p, a, span, ul, ol, li { font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }

  .article-section { padding: 60px 20px; background: white; min-height: 70vh; }
  
  /* Article Header */
  .article-header { margin-bottom: 40px; border-bottom: 2px solid #e2e8f0; padding-bottom: 20px; }
  .article-meta { display: flex; align-items: center; gap: 8px; color: #64748b; font-size: 0.9rem; margin-bottom: 15px; font-weight: 600; text-transform: uppercase; }
  .article-date { color: #0b5ed7; }
  .dot { color: #cbd5e1; }
  .article-header h1 { color: #1e293b; font-size: 2rem; line-height: 1.3; font-weight: 800; }

  /* Article Content Styles (set:html handles the tags) */
  .article-content { font-size: 1.1rem; line-height: 1.8; color: #334155; }
  .article-content :global(p) { margin-bottom: 20px; }
  .article-content :global(h3) { color: #1e293b; font-size: 1.4rem; margin-top: 30px; margin-bottom: 15px; font-weight: 700; }
  .article-content :global(ul), .article-content :global(ol) { margin-bottom: 20px; padding-left: 25px; }
  .article-content :global(li) { margin-bottom: 10px; }
  .article-content :global(strong) { color: #0b5ed7; font-weight: 700; }

  /* CTA Box */
  .article-cta {
    margin-top: 50px; padding: 30px; background: #f8fafc; 
    border-left: 5px solid #f97316; border-radius: 8px; text-align: center;
  }
  .article-cta h3 { color: #1e293b; font-size: 1.4rem; margin-bottom: 10px; }
  .article-cta p { color: #475569; margin-bottom: 20px; }
  .cta-btn {
    display: inline-block; background: #f97316; color: white;
    padding: 14px 30px; border-radius: 8px; font-weight: 800; text-decoration: none;
    font-size: 1.1rem; transition: 0.3s; box-shadow: 0 4px 15px rgba(249, 115, 22, 0.3);
  }
  .cta-btn:hover { background: #ea580c; transform: translateY(-2px); }

  /* Back Link */
  .back-link-wrap { margin-top: 40px; text-align: center; }
  .back-link { color: #64748b; text-decoration: none; font-weight: 600; font-size: 1rem; }
  .back-link:hover { color: #0b5ed7; }

  @media (min-width: 768px) {
    .article-header h1 { font-size: 2.5rem; }
  }
</style>